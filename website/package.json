{
  "name": "a3s-orm-website",
  "version": "0.0.0",
  "description": "Official multilingual and versioned documentation for A3S ORM.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run generate && rspress build",
    "check": "npm run typecheck && npm run check:content",
    "check:content": "npm run generate && node scripts/check-content.mjs",
    "check:site": "node scripts/check-built-site.mjs",
    "dev": "npm run generate && rspress dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "node scripts/generate-docs.mjs",
    "preview": "rspress preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@rspress/core": "^2.0.19",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.8.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  }
}
